<Window x:Class="CheckSumCompare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CheckSumCompare"
        mc:Ignorable="d"
        Title="CheckSum Compare" Height="550" Width="700" 
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="CheckSum Compare Tool" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- File Selection -->
        <GroupBox Grid.Row="1" Header="File Selection" Margin="0,0,0,15">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilePathTextBox" Grid.Column="0" 
                         IsReadOnly="True" Margin="0,0,10,0" 
                         VerticalContentAlignment="Center" Height="30"/>
                <Button x:Name="BrowseButton" Grid.Column="1" 
                        Content="Browse..." Width="100" Height="30"
                        Click="BrowseButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- Hash Algorithm Selection -->
        <GroupBox Grid.Row="2" Header="Hash Algorithm" Margin="0,0,0,15">
            <ComboBox x:Name="HashAlgorithmComboBox" Margin="10" Height="30"
                      VerticalContentAlignment="Center" SelectedIndex="2">
                <ComboBoxItem Content="MD5"/>
                <ComboBoxItem Content="SHA1"/>
                <ComboBoxItem Content="SHA256"/>
                <ComboBoxItem Content="SHA384"/>
                <ComboBoxItem Content="SHA512"/>
            </ComboBox>
        </GroupBox>

        <!-- Calculate Button -->
        <Button x:Name="CalculateButton" Grid.Row="3" 
                Content="Calculate Checksum" Height="35" 
                FontSize="14" FontWeight="Bold"
                Click="CalculateButton_Click" Margin="0,0,0,15"/>

        <!-- Calculated Checksum -->
        <GroupBox Grid.Row="4" Header="Calculated Checksum" Margin="0,0,0,15">
            <TextBox x:Name="CalculatedChecksumTextBox" Margin="10" 
                     IsReadOnly="True" FontFamily="Consolas" 
                     VerticalContentAlignment="Center" Height="30"/>
        </GroupBox>

        <!-- Expected Checksum -->
        <GroupBox Grid.Row="5" Header="Expected Checksum (Optional)" Margin="0,0,0,15">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ExpectedChecksumTextBox" Grid.Column="0" 
                         FontFamily="Consolas" Margin="0,0,10,0"
                         VerticalContentAlignment="Center" Height="30"/>
                <Button x:Name="CompareButton" Grid.Column="1" 
                        Content="Compare" Width="100" Height="30"
                        Click="CompareButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- Results -->
        <GroupBox Grid.Row="6" Header="Results">
            <TextBox x:Name="ResultsTextBox" Margin="10" 
                     IsReadOnly="True" TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" Background="#F5F5F5"/>
        </GroupBox>
    </Grid>
</Window>
